---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title: string
  page: 'main' | 'demo' | 'engine' | 'use'
  hint?: string
}

const { title, page, hint } = Astro.props
const base = import.meta.env.BASE_URL
const repo = 'https://github.com/toni-bobocel/weft'
const nav = [
  ['main', 'Main', base],
  ['demo', 'Demo', `${base}demo/`],
  ['engine', 'Engine', `${base}engine/`],
  ['use', 'Use it', `${base}use/`],
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Weft is a small sync engine I wrote to understand local-first software: devices edit offline and still end up with the same data."
    />
    <meta name="theme-color" content="#06090d" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <ClientRouter fallback="swap" />
  </head>
  <body data-page={page}>
    <canvas class="stage" data-stage transition:persist="stage" aria-hidden="true"></canvas>

    <div class="boot" data-boot transition:persist="boot" hidden>
      <div class="boot__time mono">Time on this device<br /><span class="dim" data-date></span></div>
      <div class="boot__clock mono"><span data-ms></span><br /><span class="dim" data-hlc></span></div>
      <div class="boot__center">
        <p class="boot__mark">weft</p>
        <button class="act enter" type="button" data-enter>enter <span class="arrow">→</span></button>
        <span class="mono dim">Better with headphones</span>
      </div>
      <pre class="boot__log mono" data-log></pre>
    </div>

    <nav class="nav mono" aria-label="Pages">
      {
        nav.map(([key, label, href]) => (
          <a href={href} aria-current={key === page ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <div class="foot mono">
      <span>Toni Bobocel, 2026</span>
      <a href={repo}>Source ↗</a>
      <a href={`${repo}/tree/main/docs/adr`}>Why it's built this way ↗</a>
      <button class="sound" type="button" data-sound transition:persist="sound" aria-pressed="false">
        Sound
        <svg viewBox="0 0 26 12" aria-hidden="true"><path data-wave d="M0 6 Q 3.25 6 6.5 6 T 13 6 T 19.5 6 T 26 6"></path></svg>
      </button>
    </div>

    {hint && <p class="hint mono">{hint}</p>}

    <main>
      <slot />
    </main>

    <script>
      import '../scripts/app.ts'
    </script>
  </body>
</html>
