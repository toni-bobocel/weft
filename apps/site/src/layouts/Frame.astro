---
import { ClientRouter } from 'astro:transitions'
import '../styles/global.css'

interface Props {
  title: string
  page: 'main' | 'demo' | 'engine' | 'use'
  hint?: string
}

const { title, page, hint } = Astro.props
const base = import.meta.env.BASE_URL
const repo = 'https://github.com/toni-bobocel/weft'
const nav = [
  ['main', 'Main', base],
  ['demo', 'Demo', `${base}demo/`],
  ['engine', 'Engine', `${base}engine/`],
  ['use', 'Use it', `${base}use/`],
] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content="Weft, a local-first sync engine: hand-written CRDTs, version-vector deltas and a relay that is just another replica."
    />
    <meta name="theme-color" content="#080608" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <ClientRouter fallback="swap" />
  </head>
  <body data-page={page}>
    <canvas class="nebula" data-nebula transition:persist="nebula" aria-hidden="true"></canvas>
    <div class="cursor" data-cursor transition:persist="cursor" aria-hidden="true"></div>

    <div class="boot" data-boot transition:persist="boot" hidden>
      <div class="boot__time mono">Time on every replica<br /><span class="dim" data-date></span></div>
      <div class="boot__clock mono"><span data-ms></span><br /><span class="dim" data-hlc></span></div>
      <div class="boot__center">
        <p class="boot__mark">weft</p>
        <button class="enter mono" type="button" data-enter>Enter <span>→</span></button>
        <span class="mono dim">Works offline too</span>
      </div>
      <pre class="boot__log mono" data-log></pre>
    </div>

    <nav class="nav mono" aria-label="Pages">
      {
        nav.map(([key, label, href]) => (
          <a href={href} aria-current={key === page ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <div class="foot mono">
      <a href={repo}>GitHub</a>
      <a href={`${repo}/tree/main/docs/adr`}>Decisions</a>
      <a href={`${repo}/blob/main/LICENSE`}>MIT licence</a>
      <a href={`${repo}/actions`}>Build status</a>
    </div>

    <span class="vertical mono">© 2026 Toni Bobocel — one state, many devices</span>

    <button class="link mono" type="button" data-link transition:persist="link" aria-pressed="true">
      <svg viewBox="0 0 12 22" aria-hidden="true"><path d="M6 0 C 0 4, 12 7, 6 11 S 0 18, 6 22"></path></svg>
      <span>Network</span>
    </button>

    {hint && <p class="hint mono">{hint}</p>}

    <main>
      <slot />
    </main>

    <script>
      import '../scripts/app.ts'
    </script>
  </body>
</html>
